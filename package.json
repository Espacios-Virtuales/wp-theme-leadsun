{
  "name": "wp-theme-leadsun",
  "version": "0.1.0",
  "private": true,
  "description": "LEADSUN Chile custom WordPress theme foundation",
  "scripts": {
    "build": "sass assets/scss/main.scss assets/css/main.css --style=compressed --no-source-map",
    "build:dev": "sass assets/scss/main.scss assets/css/main.css --style=expanded --source-map",
    "watch": "sass --watch assets/scss/main.scss:assets/css/main.css --style=expanded --source-map"
  },
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "devDependencies": {
    "sass": "1.102.0"
  }
}
